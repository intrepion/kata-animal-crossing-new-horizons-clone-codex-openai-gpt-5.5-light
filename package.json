{
  "name": "kata-animal-crossing-new-horizons-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build && npm run build:file",
    "build:file": "esbuild src/main.ts --bundle --format=iife --define:import.meta.env.DEV=false --outfile=dist/file/game.js",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "test:file": "node scripts/file-smoke.mjs",
    "test:watch": "vitest",
    "check": "npm run test && npm run build && npm run test:e2e && npm run test:file"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.5.2",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
